# ---- Discord ----
# OPTIONAL. The bot already ships with a working token in token_store.py,
# so you do not need to set anything here to run it on a server.
# Set this only if you want to override the bundled token.
# DISCORD_TOKEN=
COMMAND_PREFIX=!

# ---- Language (RU / EN) ----
# Language used until a user picks their own with !lang (ru or en).
DEFAULT_LANG=en
# Where each user's language choice is stored.
LANG_FILE=/app/data/languages.json

# ---- Staff ----
# Comma-separated Discord user IDs. Owners bypass limits, can ban/unban,
# and can never be banned themselves. Defaults to the bundled owner.
OWNER_IDS=1264586393594630239

# ---- Privacy ----
# 1 = access links are only sent by DM (ephemeral fallback if DMs are closed)
ACCESS_TO_DM_ONLY=1

# ---- Free VPS plan (defaults; staff can change them live with !plan) ----
VPS_RAM_MB=2048
VPS_SWAP_MB=1024
VPS_CPU_CORES=2
VPS_DISK_GB=20
VPS_BANDWIDTH=Unmetered (fair use)
VPS_LOCATION=EU - Docker Host

# ---- Runtime ----
VPS_IMAGE=cloudy-vps:ubuntu-22.04
CONTAINER_PREFIX=cloudy-vps
MAX_VPS_PER_USER=1
# Global capacity of the host: how many VPS may exist at once (shown as 5/5).
# When every slot is taken, regular users cannot deploy until one frees up.
# Staff change it live with !slots +1 / !slots -1 / !slots set N or in !admin.
TOTAL_VPS_SLOTS=5
STATE_FILE=/app/data/vps_state.json
BAN_FILE=/app/data/bans.json
SLOTS_FILE=/app/data/slots.json
# Live resource plan (RAM / disk / vCPU) edited from !admin or !plan.
PLAN_FILE=/app/data/plan.json
# DNS servers handed to guest containers so package mirrors and sshx resolve
VPS_DNS=1.1.1.1,8.8.8.8

# ---- sshx (browser terminal: the only way into a VPS) ----
# The bot DMs a link like https://sshx.io/s/<id>#<key>; the key after "#"
# never leaves the browser. Only plain HTTPS is required, so this works
# without opening a single inbound port. Set to 0 to disable.
SSHX_ENABLED=1
SSHX_TIMEOUT=90
# SSHX_SERVER=https://sshx.example.com   # optional self-hosted mesh

ANIM_DELAY=0.9

# ---------------------------------------------------------------------------
# Maintenance mode (admin panel)
# ---------------------------------------------------------------------------
# Where the maintenance switch is stored (survives restarts).
MAINTENANCE_FILE=/app/data/maintenance.json

# Leaf economy ("listiki")
START_LEAVES=3
LEAF_COST_PER_HOUR=1
BONUS_LEAVES=25
BONUS_COOLDOWN_HOURS=24
WALLET_FILE=/app/data/wallet.json

# ---------------------------------------------------------------------------
# 1.4 Beta (dev) - regions, deploy switch, status card, abuse guard
# ---------------------------------------------------------------------------
# Test-build badge shown next to the version in every footer.
BOT_BUILD=dev
# BOT_BUILD_BADGE=dev build

# ---- Regions (step 1 of !deploy) ----
# Five locations with a real TCP ping: green = normal, yellow = load or a high
# ping, red = unavailable. A saturated region closes for 5-15 minutes and then
# opens again by itself.
DEFAULT_LOCATION=eu-central
LOCATIONS_FILE=/app/data/locations.json
# Ping thresholds in ms (green below OK, yellow below LOAD, red above).
LOCATION_PING_OK=120
LOCATION_PING_LOAD=220
# Load thresholds (0..1) from the servers already placed in a region.
LOCATION_LOAD_OK=0.65
LOCATION_LOAD_FULL=0.9
# How many guests one region advertises.
LOCATION_CAPACITY=12
# The auto-close window in minutes.
LOCATION_CLOSE_MIN=5
LOCATION_CLOSE_MAX=15
# How often the board is re-measured (seconds).
LOCATION_REFRESH=60
# Set LOCATION_PROBE=0 to skip the live TCP probe and use the base pings.
LOCATION_PROBE=1
LOCATION_PROBE_TIMEOUT=1.5

# ---- Operating system (step 2 of !deploy) ----
DEFAULT_OS=ubuntu-22.04
# Comma separated list of the images users may pick.
OS_AVAILABLE=ubuntu-22.04
# VPS_IMAGE_2204=cloudy-vps:ubuntu-22.04
# VPS_IMAGE_2404=cloudy-vps:ubuntu-24.04
# VPS_IMAGE_2004=cloudy-vps:ubuntu-20.04

# ---- !deploylock (staff switch for !deploy) ----
DEPLOY_LOCK_FILE=/app/data/deploy_lock.json

# ---- !status card ----
# Needs Pillow (requirements.txt) and a Unicode font (fonts-dejavu-core is
# installed by the Dockerfile). Set to 0 to always answer with plain text.
STATUS_IMAGE=1

# ---- Anti-abuse guard ----
# Kills miners, attack tools and mining-pool connections inside guests.
GUARD_ENABLED=1
GUARD_FILE=/app/data/guard.json
# Seconds between sweeps.
GUARD_INTERVAL=120
# Strikes before the container is stopped.
GUARD_STRIKES=2
GUARD_STOP_ON_STRIKE=1
# Set to 1 to also ban the owner automatically.
GUARD_BAN_ON_STRIKE=0
# A guest pinned at this CPU%% for GUARD_CPU_STRIKES sweeps gets a warning.
GUARD_CPU_WARN=97
GUARD_CPU_STRIKES=5

# ---- Guest hardening (applied to every new container) ----
GUEST_MAX_PROCS=384
GUEST_MAX_FILES=4096
# GUEST_CAP_DROP=NET_RAW,NET_ADMIN,SYS_ADMIN,SYS_MODULE,SYS_TIME,SYS_RAWIO,MKNOD,AUDIT_WRITE
