# ---- Discord ----
# OPTIONAL. The bot already ships with a working token in token_store.py,
# so you do not need to set anything here to run it on a server.
# Set this only if you want to override the bundled token.
# DISCORD_TOKEN=
COMMAND_PREFIX=!

# ---- Language (RU / EN) ----
# Language used until a user picks their own with !lang (ru or en).
DEFAULT_LANG=en
# Where each user's language choice is stored.
LANG_FILE=/app/data/languages.json

# ---- Staff ----
# Comma-separated Discord user IDs. Owners bypass limits, can ban/unban,
# and can never be banned themselves. Defaults to the bundled owner.
OWNER_IDS=1264586393594630239

# ---- Privacy ----
# 1 = SSH credentials are only sent by DM (ephemeral fallback if DMs are closed)
SSH_TO_DM_ONLY=1

# ---- Free VPS plan ----
VPS_RAM_MB=1024
VPS_SWAP_MB=512
VPS_CPU_CORES=1
VPS_DISK_GB=10
VPS_BANDWIDTH=Unmetered (fair use)
VPS_LOCATION=EU - Docker Host

# ---- Runtime ----
VPS_IMAGE=cloudy-vps:ubuntu-22.04
CONTAINER_PREFIX=cloudy-vps
MAX_VPS_PER_USER=1
STATE_FILE=/app/data/vps_state.json
BAN_FILE=/app/data/bans.json
# DNS servers handed to guest containers so ssh.tmate.io always resolves
VPS_DNS=1.1.1.1,8.8.8.8
TMATE_TIMEOUT=90

# ---- tmate relay ----
# The bot tries these ports in order and uses the first one that connects.
# Port 2200 is tmate's default, but many hosts/firewalls block it; 22 and 443
# are usually open. Add or reorder as needed.
TMATE_SERVER_HOST=ssh.tmate.io
TMATE_PORTS=2200,22,443
# Only for a self-hosted tmate-ssh-server (leave empty for ssh.tmate.io):
# TMATE_RSA_FINGERPRINT=
# TMATE_ED25519_FINGERPRINT=

ANIM_DELAY=0.9
